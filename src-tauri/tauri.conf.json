{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis",
  "version": "1.0.0",
  "identifier": "com.nebubyte.orbis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orbis",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,AutofillServerCommunication,OptimizationHints,MediaRouter --disable-background-networking --disable-component-update --disable-sync --disable-domain-reliability --remote-debugging-port=9333",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "NebuByte",
    "category": "Utility",
    "shortDescription": "Neural file explorer and launcher",
    "longDescription": "Orbis maps your drives as a living network of folders, finds files by name or by describing them (on an NPU when your PC has one), and launches your apps.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}